class Solution:
    def convert(self, s: str, numRows: int) -> str:
        if numRows == 1 or numRows >= len(s):
            return s
        rows=[""]*numRows
        current_row=0
        flag=1
        for ch in s:
            rows[current_row] += ch
            if current_row == numRows - 1:
                flag=0
            elif   current_row == 0:
                flag=1
            current_row += 1 if flag else -1
        row = "".join(rows)
        return row
