class Solution:
    def reverse(self, x: int) -> int:
        rev=""
        negative = x<0
        x = abs(x)
        while x>0 :
            rem=x%10
            rev += str(rem)
            x=x//10
        rev = int(rev)
        if negative:
            rev = -rev
        if rev < -2**31 or rev > 2**31 - 1:
            return 0
        return rev
        
