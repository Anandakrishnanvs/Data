class Solution:
    def myAtoi(self, s: str) -> int:

    
        s = s.strip()
        if not s:
            return 0


        sign = 1
        i = 0
        if s[i] == '-':
            sign = -1
            i += 1
        elif s[i] == '+':
            i += 1


        integer = 0
        while i < len(s) and s[i].isdigit():
            integer = integer * 10 + int(s[i])
            i += 1


        integer = sign * integer

        if integer < -2**31:
            return -2**31
        if integer > 2**31 - 1:
            return 2**31 - 1

        return integer
